{
  "name": "@eternagame/chat",
  "version": "1.0.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternagame/eterna-chat.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "build:wc": "vite build --mode wc",
    "test": "vitest",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:oxfmt": "oxfmt",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/main.wc.js",
  "exports": {
    "types": "./dist/main.wc.d.ts",
    "default": "./dist/main.wc.js"
  },
  "imports": {
    "#assets/*": "./src/assets/*",
    "#commands": "./src/commands/index.ts",
    "#commands/*": "./src/commands/*",
    "#components/*": "./src/components/*",
    "#composables/*": "./src/composables/*",
    "#constants": "./src/constants/index.ts",
    "#constants/*": "./src/constants/*",
    "#models": "./src/models/index.ts",
    "#models/*": "./src/models/*",
    "#services": "./src/services/index.ts",
    "#services/*": "./src/services/*",
    "#stores": "./src/stores/index.ts",
    "#stores/*": "./src/stores/*",
    "#styles/*": "./src/styles/*",
    "#utils": "./src/utils/index.ts",
    "#utils/*": "./src/utils/*"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.45.10",
    "focus-trap": "^8.2.3",
    "irc-framework": "^4.14.0",
    "loglevel": "^1.9.2",
    "markdown-it": "^14.3.2",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-regex": "^0.2.2",
    "markdown-it-underline": "^1.0.1",
    "pinia": "^4.0.3",
    "stream-browserify": "^3.0.0",
    "type-fest": "^5.10.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@pinia/testing": "^2.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/language-core": "^3.3.12",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "core-js": "^3.50.0",
    "eventemitter3": "^5.0.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "unplugin-dts": {
      "@vue/language-core": "$@vue/language-core"
    }
  }
}
